    {
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "agent_memory"
        },
        "operation": "get",
        "matchType": "anyCondition",
        "filters": {
          "conditions": [
            {
              "keyName": "project",
              "condition": "eq",
              "keyValue": "={{ $('Parse request').first().json.project }}"
            },
            {
              "keyName": "project",
              "condition": "eq",
              "keyValue": "general"
            }
          ]
        },
        "limit": 30,
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "DESC"
      },
      "id": "n-load-memory",
      "name": "Load memory",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -60,
        200
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const project = $('Parse request').first().json.project;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.note);\nconst lines = [];\nlet size = 0;\nfor (const r of rows) {\n  const scope = r.project === project && project !== 'general' ? 'this repo' : 'general';\n  const line = `- [${scope}, ${r.kind || 'note'}] ${r.note}`;\n  if (size + line.length > 1200 || lines.length >= 8) break;\n  lines.push(line);\n  size += line.length;\n}\nreturn [{ json: { memoryText: lines.join('\\n') || '(no memory yet)', memoryCount: lines.length } }];"
      },
      "id": "n-pick-memory",
      "name": "Pick memory",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        200
      ]
    },
    {
