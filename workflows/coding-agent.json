        "url": "http://sandbox:8080/turn",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ taskId: $('Parse request').first().json.taskId, agentOutput: String($json.output || '').slice(0, 400), agentError: $json.error ? String($json.error.message || $json.error).slice(0, 400) : '' }) }}",
        "options": {
          "timeout": 180000
        }
      },
