    {
      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst text = String(msg.text || '').trim();\nconst chatId = msg.chat ? String(msg.chat.id) : '';\nconst match = text.match(/https:\\/\\/github\\.com\\/[\\w.-]+\\/[\\w.-]+/);\nconst repoUrl = match ? match[0].replace(/\\.git$/, '').replace(/\\.$/, '') : '';\nconst isCommand = text === '' || text.startsWith('/start') || text.startsWith('/help');\nreturn [{\n  json: {\n    chatId,\n    text,\n    repoUrl,\n    mode: repoUrl ? 'existing-codebase' : 'new-project',\n    project: repoUrl || 'general',\n    taskId: 't' + Date.now().toString(36),\n    isTask: !isCommand,\n  },\n}];"
      },
      "id": "n-parse-request",
      "name": "Parse request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "Is a task?-c",
              "leftValue": "={{ $json.isTask }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
