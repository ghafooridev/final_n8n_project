{
  "id": "CodeAgentAskHum1",
  "name": "Coding Agent - Ask Human",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "question",
              "type": "string"
            }
          ]
        }
      },
      "id": "n-when-called-by-agent",
      "name": "When called by agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://sandbox:8080/state",
        "options": {}
      },
      "id": "n-get-task",
      "name": "Get task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $json.chatId }}",
        "message": "=The coding agent needs your input (task {{ $json.taskId }}):\n\n{{ $('When called by agent').first().json.question }}\n\nTap the button and type your answer. You have 5 minutes.",
        "responseType": "freeText",
        "options": {
          "appendAttribution": false,
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 5,
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "id": "n-ask-on-telegram",
      "name": "Ask on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "webhookId": "wh-ask-human",
      "credentials": {
        "telegramApi": {
          "id": "CredTelegram0001",
          "name": "Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "answer",
              "value": "={{ ($json.data && $json.data.text) ? $json.data.text : 'No answer within 5 minutes. Make a reasonable assumption, write it in your notes, and continue.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n-answer",
      "name": "Answer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "When called by agent": {
      "main": [
        [
          {
            "node": "Get task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get task": {
      "main": [
        [
          {
            "node": "Ask on Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask on Telegram": {
      "main": [
        [
          {
            "node": "Answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
